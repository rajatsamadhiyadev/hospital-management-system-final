# ============================================
#  Copy this file to ".env" and fill it in
#    Mac/Linux :  cp .env.example .env
#    Windows   :  copy .env.example .env
# ============================================

# ---- DATABASE (pick ONE option, delete/comment the other) ----

# OPTION A — Local MongoDB installed on your laptop
MONGO_URI=mongodb://127.0.0.1:27017/hms

# OPTION B — MongoDB Atlas (free cloud, no install needed)
# Atlas -> Database -> Connect -> Drivers -> copy the string.
# Replace <password> with your real DB-user password and keep "/hms" before the "?"
# MONGO_URI=mongodb+srv://myuser:<password>@cluster0.xxxxx.mongodb.net/hms?retryWrites=true&w=majority

# ---- SESSION ----
# Any long random string. Change this for a real deployment.
SESSION_SECRET=change-this-to-any-long-random-string

# ---- SERVER ----
PORT=3000
NODE_ENV=development

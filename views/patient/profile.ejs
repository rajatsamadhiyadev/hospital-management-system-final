<div class="row justify-content-center">
  <div class="col-lg-7">

    <h4 class="fw-bold mb-4"><i class="fa-regular fa-user text-primary me-2"></i>My Profile</h4>

    <div class="card border-0 shadow-sm mb-3">
      <div class="card-body p-4 d-flex align-items-center">
        <span class="avatar avatar-lg bg-primary"><%= me.name.charAt(0).toUpperCase() %></span>
        <div class="ms-3">
          <h5 class="fw-bold mb-0"><%= me.name %></h5>
          <div class="small text-muted"><%= me.email %></div>
          <span class="badge bg-info-subtle text-info mt-1 text-capitalize"><%= me.role %></span>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-0 pt-3">
        <h6 class="fw-bold mb-0">Edit Details</h6>
      </div>
      <div class="card-body p-4 pt-2">
        <form action="/patient/profile" method="POST">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold small">Full Name</label>
              <input type="text" name="name" class="form-control" value="<%= me.name %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold small">Email (locked)</label>
              <input type="email" class="form-control" value="<%= me.email %>" disabled>
              <div class="form-text">Your records are linked to this email.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold small">Phone</label>
              <input type="text" name="phone" class="form-control" value="<%= me.phone %>">
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold small">Age</label>
              <input type="number" name="age" class="form-control" min="0" max="130" value="<%= me.age || '' %>">
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold small">Gender</label>
              <select name="gender" class="form-select">
                <option value="">--</option>
                <% ['Male','Female','Other'].forEach(g => { %>
                  <option <%= me.gender === g ? 'selected' : '' %>><%= g %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold small">Blood Group</label>
              <select name="bloodGroup" class="form-select">
                <option value="">--</option>
                <% ['A+','A-','B+','B-','O+','O-','AB+','AB-'].forEach(b => { %>
                  <option <%= me.bloodGroup === b ? 'selected' : '' %>><%= b %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-8">
              <label class="form-label fw-semibold small">Address</label>
              <input type="text" name="address" class="form-control" value="<%= me.address %>">
            </div>
          </div>

          <button type="submit" class="btn btn-primary fw-semibold px-4 mt-4">
            <i class="fa-solid fa-floppy-disk me-2"></i>Save Changes
          </button>
        </form>
      </div>
    </div>

  </div>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
  <h4 class="fw-bold mb-0"><i class="fa-regular fa-calendar-check text-primary me-2"></i>My Appointments</h4>
  <a href="/patient/appointments/new" class="btn btn-primary"><i class="fa-solid fa-calendar-plus me-2"></i>Book New</a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <% if (!appointments.length) { %>
      <div class="empty-state">
        <i class="fa-regular fa-calendar-xmark"></i>
        <p class="mb-2">You have no appointments yet.</p>
        <a href="/patient/appointments/new" class="btn btn-sm btn-primary">Book your first visit</a>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr><th>Doctor</th><th>Date &amp; Time</th><th>Reason</th><th>Status</th><th class="text-end">Action</th></tr>
          </thead>
          <tbody>
            <% appointments.forEach(a => { %>
              <tr>
                <td>
                  <div class="fw-semibold">Dr. <%= a.doctor ? a.doctor.name : '—' %></div>
                  <small class="text-muted"><%= a.doctor && a.doctor.specialization ? a.doctor.specialization : '' %></small>
                </td>
                <td class="small">
                  <div class="fw-semibold"><%= a.date.toDateString() %></div>
                  <div class="text-muted"><%= a.timeSlot %></div>
                </td>
                <td class="small text-muted"><%= a.reason || '—' %></td>
                <td>
                  <span class="badge rounded-pill bg-<%= a.status==='Completed'?'success':(a.status==='Cancelled'?'danger':'warning') %>-subtle text-<%= a.status==='Completed'?'success':(a.status==='Cancelled'?'danger':'warning') %>">
                    <%= a.status %>
                  </span>
                </td>
                <td class="text-end">
                  <% if (a.status === 'Scheduled') { %>
                    <form action="/patient/appointments/<%= a._id %>/cancel" method="POST" class="d-inline"
                          onsubmit="return confirm('Cancel this appointment?')">
                      <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-xmark me-1"></i>Cancel</button>
                    </form>
                  <% } else { %>
                    <span class="text-muted small">—</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

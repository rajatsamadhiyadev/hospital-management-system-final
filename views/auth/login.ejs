<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4 p-lg-5">

        <div class="text-center mb-4">
          <div class="role-icon bg-primary-subtle text-primary mx-auto"><i class="fa-solid fa-hospital-user"></i></div>
          <h4 class="fw-bold mt-3 mb-1">Welcome Back</h4>
          <p class="text-muted small mb-0">Sign in to your MediCare account</p>
        </div>

        <form action="/login" method="POST">
          <div class="mb-3">
            <label class="form-label fw-semibold small">Email Address</label>
            <div class="input-group">
              <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
              <input type="email" name="email" class="form-control" placeholder="you@example.com" required autofocus>
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold small">Password</label>
            <div class="input-group">
              <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
              <input type="password" name="password" id="pwd" class="form-control" placeholder="••••••••" required>
              <button class="btn btn-outline-secondary" type="button" onclick="togglePwd('pwd', this)">
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="btn btn-primary w-100 fw-semibold py-2">
            <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In
          </button>
        </form>

        <p class="text-center text-muted small mt-4 mb-0">
          New patient? <a href="/register" class="fw-semibold text-decoration-none">Create an account</a>
        </p>

      </div>
    </div>

    <div class="alert alert-light border shadow-sm mt-3 small mb-0">
      <strong><i class="fa-solid fa-circle-info text-primary me-1"></i> Demo accounts</strong>
      <span class="text-muted">(after running <code>npm run seed</code>)</span>
      <hr class="my-2">
      <div><i class="fa-solid fa-user-doctor text-primary me-1"></i> Doctor &nbsp;— <code>doctor@hms.com</code> / <code>123456</code></div>
      <div><i class="fa-solid fa-clipboard-user text-success me-1"></i> Reception — <code>reception@hms.com</code> / <code>123456</code></div>
      <div><i class="fa-solid fa-hospital-user text-info me-1"></i> Patient &nbsp;— <code>patient@hms.com</code> / <code>123456</code></div>
    </div>
  </div>
</div>

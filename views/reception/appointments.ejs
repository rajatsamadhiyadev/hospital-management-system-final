<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <h4 class="fw-bold mb-0"><i class="fa-regular fa-calendar-check text-primary me-2"></i>All Appointments</h4>
  <a href="/reception/appointments/new" class="btn btn-primary"><i class="fa-solid fa-calendar-plus me-2"></i>Book Appointment</a>
</div>

<div class="card border-0 shadow-sm mb-3">
  <div class="card-body py-3">
    <div class="row g-2 align-items-center">
      <div class="col-md-6">
        <form action="/reception/appointments" method="GET" class="input-group">
          <input type="hidden" name="status" value="<%= activeStatus %>">
          <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass"></i></span>
          <input type="text" name="q" class="form-control" placeholder="Search by patient name, email or phone" value="<%= q %>">
          <button class="btn btn-outline-primary">Search</button>
        </form>
      </div>
      <div class="col-md-6 text-md-end">
        <div class="btn-group btn-group-sm">
          <% ['all','Scheduled','Completed','Cancelled'].forEach(s => { %>
            <a href="/reception/appointments?status=<%= s %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
               class="btn btn-<%= activeStatus === s ? 'primary' : 'outline-primary' %>">
              <%= s === 'all' ? 'All' : s %>
            </a>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <% if (!appointments.length) { %>
      <div class="empty-state">
        <i class="fa-regular fa-calendar-xmark"></i>
        <p class="mb-0">No appointments match your filter.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr><th>Patient</th><th>Doctor</th><th>Date &amp; Time</th><th>Status</th><th class="text-end">Actions</th></tr>
          </thead>
          <tbody>
            <% appointments.forEach(a => { %>
              <tr>
                <td>
                  <div class="fw-semibold"><%= a.patientName %></div>
                  <small class="text-muted"><%= a.patientEmail %></small>
                  <% if (a.patientPhone) { %><small class="text-muted d-block"><%= a.patientPhone %></small><% } %>
                </td>
                <td class="small">
                  Dr. <%= a.doctor ? a.doctor.name : '—' %>
                  <div class="text-muted"><%= a.doctor && a.doctor.specialization ? a.doctor.specialization : '' %></div>
                </td>
                <td class="small">
                  <div class="fw-semibold"><%= a.date.toDateString() %></div>
                  <div class="text-muted"><%= a.timeSlot %></div>
                </td>
                <td>
                  <span class="badge rounded-pill bg-<%= a.status==='Completed'?'success':(a.status==='Cancelled'?'danger':'warning') %>-subtle text-<%= a.status==='Completed'?'success':(a.status==='Cancelled'?'danger':'warning') %>">
                    <%= a.status %>
                  </span>
                </td>
                <td class="text-end text-nowrap">
                  <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">Status</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                      <% ['Scheduled','Completed','Cancelled'].forEach(s => { %>
                        <li>
                          <form action="/reception/appointments/<%= a._id %>/status" method="POST">
                            <input type="hidden" name="status" value="<%= s %>">
                            <button class="dropdown-item <%= a.status===s ? 'active' : '' %>"><%= s %></button>
                          </form>
                        </li>
                      <% }) %>
                    </ul>
                  </div>
                  <form action="/reception/appointments/<%= a._id %>/delete" method="POST" class="d-inline"
                        onsubmit="return confirm('Delete this appointment permanently?')">
                    <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

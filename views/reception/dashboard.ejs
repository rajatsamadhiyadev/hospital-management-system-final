<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
  <div>
    <h4 class="fw-bold mb-1">Reception Desk</h4>
    <p class="text-muted mb-0 small">Welcome, <%= currentUser.name %> — <%= new Date().toDateString() %></p>
  </div>
  <div>
    <a href="/reception/patients/new" class="btn btn-outline-primary me-2"><i class="fa-solid fa-user-plus me-2"></i>New Patient</a>
    <a href="/reception/appointments/new" class="btn btn-primary"><i class="fa-solid fa-calendar-plus me-2"></i>Book Appointment</a>
  </div>
</div>

<div class="row g-3 mb-4">
  <%- include('../partials/statCard', { color:'primary', icon:'fa-regular fa-calendar-days', value: stats.todayCount,  label:"Today's Appointments" }) %>
  <%- include('../partials/statCard', { color:'warning', icon:'fa-regular fa-clock',          value: stats.pending,     label:'Pending' }) %>
  <%- include('../partials/statCard', { color:'success', icon:'fa-solid fa-user-doctor',      value: stats.doctorCount, label:'Doctors' }) %>
  <%- include('../partials/statCard', { color:'info',    icon:'fa-solid fa-users',            value: stats.patientCount,label:'Registered Patients' }) %>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-center">
    <h6 class="fw-bold mb-0"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Recent Bookings</h6>
    <a href="/reception/appointments" class="btn btn-sm btn-outline-primary">View All</a>
  </div>
  <div class="card-body pt-2">
    <% if (!recent.length) { %>
      <div class="empty-state">
        <i class="fa-regular fa-calendar-xmark"></i>
        <p class="mb-0">No appointments booked yet.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr><th>Patient</th><th>Doctor</th><th>Date</th><th>Time</th><th>Status</th></tr>
          </thead>
          <tbody>
            <% recent.forEach(a => { %>
              <tr>
                <td>
                  <div class="fw-semibold"><%= a.patientName %></div>
                  <small class="text-muted"><%= a.patientEmail %></small>
                </td>
                <td class="small">
                  Dr. <%= a.doctor ? a.doctor.name : '—' %>
                  <div class="text-muted"><%= a.doctor && a.doctor.specialization ? a.doctor.specialization : '' %></div>
                </td>
                <td class="small"><%= a.date.toDateString() %></td>
                <td class="small"><%= a.timeSlot %></td>
                <td>
                  <span class="badge rounded-pill bg-<%= a.status==='Completed'?'success':(a.status==='Cancelled'?'danger':'warning') %>-subtle text-<%= a.status==='Completed'?'success':(a.status==='Cancelled'?'danger':'warning') %>">
                    <%= a.status %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

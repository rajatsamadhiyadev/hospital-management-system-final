<h4 class="fw-bold mb-4"><i class="fa-solid fa-users text-primary me-2"></i>My Patients</h4>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <% if (!patients.length) { %>
      <div class="empty-state">
        <i class="fa-solid fa-user-slash"></i>
        <p class="mb-0">You haven't treated any patients yet.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr><th>Patient</th><th>Contact</th><th>Visits</th><th>Prescriptions</th><th>Last Visit</th><th class="text-end">Action</th></tr>
          </thead>
          <tbody>
            <% patients.forEach(p => { %>
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <span class="avatar avatar-dark me-2"><%= p.name.charAt(0).toUpperCase() %></span>
                    <div>
                      <div class="fw-semibold"><%= p.name %></div>
                      <small class="text-muted"><%= p.email %></small>
                      <% if (!p.registered) { %>
                        <span class="badge bg-secondary-subtle text-secondary ms-1">walk-in</span>
                      <% } %>
                    </div>
                  </div>
                </td>
                <td class="small"><%= p.phone || '—' %></td>
                <td><span class="badge bg-primary-subtle text-primary"><%= p.visits %></span></td>
                <td><span class="badge bg-info-subtle text-info"><%= p.scripts %></span></td>
                <td class="small text-muted"><%= p.lastVisit ? p.lastVisit.toDateString() : '—' %></td>
                <td class="text-end">
                  <a href="/doctor/prescriptions/new?email=<%= encodeURIComponent(p.email) %>" class="btn btn-sm btn-outline-primary">
                    <i class="fa-solid fa-file-prescription me-1"></i>Prescribe
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
  <h4 class="fw-bold mb-0"><i class="fa-solid fa-file-prescription text-primary me-2"></i>Prescriptions Issued</h4>
  <a href="/doctor/prescriptions/new" class="btn btn-primary"><i class="fa-solid fa-plus me-2"></i>New Prescription</a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <% if (!prescriptions.length) { %>
      <div class="empty-state">
        <i class="fa-regular fa-file-lines"></i>
        <p class="mb-0">No prescriptions issued yet.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr><th>Date</th><th>Patient</th><th>Diagnosis</th><th>Medicines</th><th>Follow-up</th><th class="text-end">Action</th></tr>
          </thead>
          <tbody>
            <% prescriptions.forEach(p => { %>
              <tr>
                <td class="small fw-semibold"><%= p.createdAt.toDateString() %></td>
                <td>
                  <div class="fw-semibold"><%= p.patientName %></div>
                  <small class="text-muted"><%= p.patientEmail %></small>
                </td>
                <td class="small"><%= p.diagnosis %></td>
                <td><span class="badge bg-info-subtle text-info"><%= p.medicines.length %> item(s)</span></td>
                <td class="small text-muted"><%= p.followUpDate ? p.followUpDate.toDateString() : '—' %></td>
                <td class="text-end">
                  <a href="/doctor/prescriptions/<%= p._id %>" class="btn btn-sm btn-outline-primary">
                    <i class="fa-regular fa-eye me-1"></i>View
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

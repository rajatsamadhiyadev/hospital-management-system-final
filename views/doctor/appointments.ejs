<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
  <h4 class="fw-bold mb-0"><i class="fa-regular fa-calendar-check text-primary me-2"></i>My Appointments</h4>
  <div class="btn-group btn-group-sm">
    <% ['all','Scheduled','Completed','Cancelled'].forEach(s => { %>
      <a href="/doctor/appointments?status=<%= s %>"
         class="btn btn-<%= activeStatus === s ? 'primary' : 'outline-primary' %>">
        <%= s === 'all' ? 'All' : s %>
      </a>
    <% }) %>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <% if (!appointments.length) { %>
      <div class="empty-state">
        <i class="fa-regular fa-calendar-xmark"></i>
        <p class="mb-0">No appointments found for this filter.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr><th>Date</th><th>Time</th><th>Patient</th><th>Reason</th><th>Status</th><th class="text-end">Actions</th></tr>
          </thead>
          <tbody>
            <% appointments.forEach(a => { %>
              <tr>
                <td class="small fw-semibold"><%= a.date.toDateString() %></td>
                <td class="small"><%= a.timeSlot %></td>
                <td>
                  <div class="fw-semibold"><%= a.patientName %></div>
                  <small class="text-muted"><%= a.patientEmail %></small>
                </td>
                <td class="small text-muted"><%= a.reason || '—' %></td>
                <td>
                  <span class="badge rounded-pill bg-<%= a.status==='Completed'?'success':(a.status==='Cancelled'?'danger':'warning') %>-subtle text-<%= a.status==='Completed'?'success':(a.status==='Cancelled'?'danger':'warning') %>">
                    <%= a.status %>
                  </span>
                </td>
                <td class="text-end text-nowrap">
                  <% if (a.status !== 'Cancelled') { %>
                    <form action="/doctor/appointments/<%= a._id %>/toggle" method="POST" class="d-inline">
                      <button class="btn btn-sm btn-outline-<%= a.status==='Completed'?'secondary':'success' %>">
                        <i class="fa-solid <%= a.status==='Completed'?'fa-rotate-left':'fa-check' %> me-1"></i>
                        <%= a.status==='Completed' ? 'Undo' : 'Complete' %>
                      </button>
                    </form>
                  <% } %>
                  <a href="/doctor/prescriptions/new?appointment=<%= a._id %>" class="btn btn-sm btn-outline-primary">
                    <i class="fa-solid fa-file-prescription"></i>
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
